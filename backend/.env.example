# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
# Option A — Railway injects DATABASE_URL automatically (overrides DB_* below)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=portfolio_db

# One-shot: set DATABASE_SYNC=true only on first deploy so TypeORM creates tables.
# Remove immediately after redeploy — use migrations for future schema changes.
# DATABASE_SYNC=false

# Production TLS — auto-on when NODE_ENV=production and DB_HOST is not localhost.
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# ═══════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════
JWT_SECRET=change-me-long-random-string-min-32-chars
# POST /api/auth/login — leading/trailing spaces are trimmed on compare
ADMIN_PASSWORD=Karan@Admin2025

# ═══════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════
PORT=3000
FRONTEND_URL=http://localhost:4200
# Comma-separated extra origins (Vercel preview URLs, alternate domains)
# ADDITIONAL_CORS_ORIGINS=https://karan-portfolio.vercel.app
NODE_ENV=development
# Swagger UI — auto-disabled in production. Force-enable only behind IP/VPN.
# ENABLE_SWAGGER=false

# ═══════════════════════════════════════════════════════
# STRIPE — LOCAL (test mode)
# ═══════════════════════════════════════════════════════
# 1. Go to https://dashboard.stripe.com/test/apikeys
# 2. Copy "Secret key"  → sk_test_xxxxxxxx
# 3. Run Stripe CLI:    stripe listen --forward-to localhost:3000/api/payments/webhook
#    The CLI prints: "Your webhook signing secret is whsec_..."
# 4. Paste both below. Test card: 4242 4242 4242 4242, any future expiry, any CVV.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─ Stripe — PRODUCTION (live mode, set in Railway env vars — NOT here) ─
# STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Register the webhook at: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://<your-railway-backend-url>/api/payments/webhook
# Event to listen to: checkout.session.completed

# ─ Currency & amounts (smallest unit — paise for INR, cents for USD) ─
# INR examples: ₹999 = 99900 paise | ₹2499 = 249900 | ₹4999 = 499900
# USD examples: $199 = 19900 cents  | $499  = 49900  | $999  = 99900
STRIPE_CURRENCY=inr
STRIPE_STARTER_AMOUNT=99900
STRIPE_STANDARD_AMOUNT=249900
STRIPE_ENTERPRISE_AMOUNT=499900
STRIPE_INSIGHTS_AMOUNT=49900
INSIGHTS_ACCESS_DAYS=30

# ═══════════════════════════════════════════════════════
# EMAIL / SMTP (used for OTP verification)
# ═══════════════════════════════════════════════════════
# Gmail: enable 2FA, create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@karankapoor.dev

# AI — smart content engine key (kept server-side only, never expose to frontend)
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════
# OPTIONAL SERVICES
# ═══════════════════════════════════════════════════════
# Python resume analyzer (FastAPI). Local: http://127.0.0.1:8010
# RESUME_SERVICE_URL=http://127.0.0.1:8010
