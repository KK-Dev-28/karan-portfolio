# Option A — Railway / hosted Postgres often injects this (overrides DB_* below when set)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=portfolio_db
# One-shot: set DATABASE_SYNC=true on Railway only for first deploy so TypeORM creates tables. Remove immediately after redeploy or use migrations instead.
# DATABASE_SYNC=false

# Production TLS to Postgres (auto-on when NODE_ENV=production and DB_HOST is not localhost). Set false for local-only.
# DB_SSL=false
# Set false only if your provider needs it (e.g. some Railway internal URLs); default true when DB_SSL is on
# DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change-me-long-random-string
# Used by POST /api/auth/login — leading/trailing spaces are trimmed on compare
ADMIN_PASSWORD=Karan@Admin2025

PORT=3000
FRONTEND_URL=http://localhost:4200
# Comma-separated extra origins (preview deploys, alternate www host)
# ADDITIONAL_CORS_ORIGINS=https://your-app.vercel.app
NODE_ENV=development
# Never enable in public production unless gated (IP/VPN). Swagger is off when NODE_ENV=production.
# ENABLE_SWAGGER=false

# Stripe — https://dashboard.stripe.com/apikeys
# Use test keys locally; live keys in production. Webhook: checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional overrides (amounts in smallest currency unit, e.g. cents or paise)
STRIPE_CURRENCY=usd
STRIPE_STARTER_AMOUNT=19900
STRIPE_STANDARD_AMOUNT=49900
STRIPE_ENTERPRISE_AMOUNT=99900
STRIPE_INSIGHTS_AMOUNT=9900
INSIGHTS_ACCESS_DAYS=30

# Python resume analyzer (FastAPI). Local: http://127.0.0.1:8010
# Railway: internal URL or public URL of the second service
RESUME_SERVICE_URL=http://127.0.0.1:8010
