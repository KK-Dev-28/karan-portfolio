# ═══════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════
# Option A — Railway injects DATABASE_URL automatically (overrides DB_* below)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=portfolio_db

# One-shot: set DATABASE_SYNC=true only on first deploy so TypeORM creates tables.
# Remove immediately after redeploy — use migrations for future schema changes.
# DATABASE_SYNC=false

# Production TLS — auto-on when NODE_ENV=production and DB_HOST is not localhost.
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# ═══════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════
JWT_SECRET=change-me-long-random-string-min-32-chars
# POST /api/auth/login — leading/trailing spaces are trimmed on compare
ADMIN_PASSWORD=Karan@Admin2025

# ═══════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════
PORT=3000
FRONTEND_URL=http://localhost:4200
# Comma-separated extra origins (Vercel preview URLs, alternate domains)
# ADDITIONAL_CORS_ORIGINS=https://karan-portfolio.vercel.app
NODE_ENV=development
# Swagger UI — auto-disabled in production. Force-enable only behind IP/VPN.
# ENABLE_SWAGGER=false

# ═══════════════════════════════════════════════════════
# RAZORPAY — LOCAL (test mode)
# ═══════════════════════════════════════════════════════
# 1. Go to https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
# 2. Generate a test key → copy Key ID + Key Secret
# 3. For local webhook testing, use a tunnel (e.g. `ngrok http 3000`) and register
#    https://<tunnel-host>/api/payments/webhook in Razorpay Dashboard → Webhooks,
#    then paste the webhook secret it gives you below.
# 4. Test card: 4111 1111 1111 1111, any future expiry, any CVV.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ─ Razorpay — PRODUCTION (live mode, set in Railway env vars — NOT here) ─
# RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
# RAZORPAY_KEY_SECRET=REPLACE_ME
# RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
# Register the webhook at: https://dashboard.razorpay.com/app/webhooks
# Endpoint URL: https://<your-railway-backend-url>/api/payments/webhook
# Event to listen to: payment.captured

# ─ Currency & amounts (smallest unit — paise for INR) ─
# ₹999 = 99900 paise | ₹2499 = 249900 | ₹4999 = 499900
RAZORPAY_CURRENCY=inr
RAZORPAY_STARTER_AMOUNT=99900
RAZORPAY_STANDARD_AMOUNT=249900
RAZORPAY_ENTERPRISE_AMOUNT=499900
RAZORPAY_INSIGHTS_AMOUNT=49900
INSIGHTS_ACCESS_DAYS=30

# ═══════════════════════════════════════════════════════
# EMAIL / SMTP (used for OTP verification)
# ═══════════════════════════════════════════════════════
# Gmail: enable 2FA, create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@karankapoor.dev

# AI — smart content engine key (kept server-side only, never expose to frontend)
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════
# OPTIONAL SERVICES
# ═══════════════════════════════════════════════════════
# Python resume analyzer (FastAPI). Local: http://127.0.0.1:8010
# RESUME_SERVICE_URL=http://127.0.0.1:8010
